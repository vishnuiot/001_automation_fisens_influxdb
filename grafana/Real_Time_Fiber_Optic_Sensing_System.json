                      },
                      "spec": {
                        "query": "from(bucket:\"sensors\")\r\n  |> range(start: -1h)\r\n  |> filter(fn: (r) => r._measurement == \"peak_spectrum\")\r\n  |> filter(fn: (r) => r._field == \"peak_wavelength_nm\")\r\n  |> filter(fn: (r) => r._value > 0 and r._value <= 830)\r\n  |> map(fn: (r) => ({r with _series:\r\n    if r.peak_number == \"1\" then \"P1 - Blue (806 nm)\"\r\n    else if r.peak_number == \"2\" then \"P2 - Green (813 nm)\"\r\n    else if r.peak_number == \"3\" then \"P3 - Red (816 nm)\"\r\n    else \"Unknown\"}))\r\n  |> sort(columns: [\"_time\"], desc: true)\r\n  "
                      }
